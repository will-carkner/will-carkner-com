---
import Simple from '../layouts/Simple.astro'

const happyThings = [
  "eating food when i'm really hungry",
'climbing, hiking, rowing', 'my family (mom, dad, and harry)', 'making progress on provenmetal', 'finding good deals on clothes at thrift stores']

const links = [
  { label: 'photos', href: '/photos' },
  { label: 'blog', href: '/blog' },
]
---

<Simple title="will carkner" home>
  <div class="lower">
    <h1>will carkner</h1>
    <p>things that make me happy:</p>
    <ul>
      {happyThings.map((thing) => <li>{thing}</li>)}
    </ul>
    <nav>
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  </div>
</Simple>

<style>
  h1 {
    font-size: 1.5rem;
    font-weight: 400;
    margin: 0 0 2rem;
  }
  p {
    margin: 0 0 0.75rem;
  }
  ul {
    list-style: disc;
    padding: 0 0 0 1.25rem;
    margin: 0;
  }
  li {
    margin: 0 0 0.25rem;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 3rem;
  }
</style>
