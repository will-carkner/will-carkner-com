---
import Simple from '../layouts/Simple.astro'
---

<Simple title="quote | will carkner" description="a quote will carkner likes">
  <blockquote class="lower">
    Fall in love and stay in love. Explode. Don't intellectualize. Get
    passionate about ideas. Cram your head full of images. Stay in the library.
    Stay off the internet and all that crap. Read all the great books.
    Read all the great poetry. See all the great films. Fill your life with
    metaphors. And then explode.
  </blockquote>
  <p class="by lower">ray bradbury</p>
</Simple>

<style>
  blockquote {
    margin: 0;
    color: #ccc;
    font-size: 1.1rem;
    line-height: 1.7;
  }
  .by {
    color: #888;
    margin-top: 2rem;
  }
</style>
