---
import Simple from '../layouts/Simple.astro'
---

<Simple title="quote | will carkner" description="a quote will carkner likes">
  <blockquote>
    Fall in love and <b>stay in love</b>. Explode. Don't intellectualize. Get
    passionate about ideas. Cram your head full of images. Stay in the library.
    Stay off the internet and all that crap. <b>Read all the great books</b>.
    Read all the great poetry. See all the great films. Fill your life with
    metaphors. <b>And then explode.</b>
  </blockquote>
  <p class="by lower">ray bradbury</p>
</Simple>

<style>
  blockquote {
    margin: 0;
    color: #ccc;
    font-size: 1.1rem;
    line-height: 1.7;
  }
  b {
    color: #fff;
    font-weight: 500;
  }
  .by {
    color: #888;
    margin-top: 2rem;
  }
</style>
