---

<Simple title="photos — will carkner" description="photos by will carkner" gallery>
  <h1>photos</h1>
  {
    years.map(({ year, columns }, yearIdx) => (
      <section>
        <h2>{year}</h2>
        <div class="grid">
          {columns.map((images) => (
            <div class="col">
              {images.map((key, i) => (
                <Image
                  src={pic(key)}
                  alt={altFrom(key, year, i)}
                  widths={[240, 480, 720]}
                  sizes="(max-width: 768px) 50vw, 240px"
                  loading={yearIdx === 0 && i < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              ))}
            </div>
          ))}
        </div>
      </section>
    ))
  }
</Simple>

<style>
  h1,
  h2 {
    font-weight: 400;
    margin: 0;
  }
  h1 {
    font-size: 1.5rem;
    margin-bottom: 2rem;
  }
  h2 {
    font-size: 0.9rem;
    color: #888;
    margin-bottom: 0.75rem;
  }
  section {
    margin-bottom: 3rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
    align-items: start;
  }
  .col {
    display: grid;
    gap: 0.5rem;
  }
  .grid img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 3px;
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
