---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  title: string
  tags: string[]
  image: ImageMetadata
  url: string
  class?: string
}

const { title, tags, image, url, class: className } = Astro.props
const hasUrl = url && url.length > 0
const isExternal = hasUrl && /^https?:\/\//.test(url)

const Wrapper = hasUrl ? 'a' : 'div'
---

<Wrapper
  href={hasUrl ? url : undefined}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
  class="no-underline w-full block"
>
  <div
    class:list={[
      'flex flex-row items-center gap-3 sm:gap-4 duration-300 sm:hover:scale-[1.03]',
    ]}
  >
    <Image
      src={image}
      width={240}
      class:list={[
        'h-16 sm:h-24 w-auto shrink-0 border border-gray-600 rounded-lg',
        className,
      ]}
      alt={`${title} project thumbnail`}
      loading="lazy"
    />
    <div class="flex min-w-0 flex-col space-y-2 text-left">
      <p class="text-lg sm:text-2xl font-semibold break-words">
        {title}
      </p>
      <div class="flex flex-wrap items-center justify-start gap-2">
        {
          tags.map((tag) => (
            <span class="bg-slate-600 w-fit bg-opacity-50 text-xs shadow-lg rounded-md px-2 py-1 text-white">
              {tag}
            </span>
          ))
        }
      </div>
    </div>
  </div>
</Wrapper>
