---
import type { CollectionEntry } from 'astro:content'
import Simple from './Simple.astro'

type Props = CollectionEntry<'blog'>['data']

const { title, pubDate, updatedDate } = Astro.props

const formatDate = (date: Date) =>
  date
    .toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
    .toLowerCase()
---

<Simple title={`${title.toLowerCase()} — will carkner`} wide back={{ label: 'blog', href: '/blog' }}>
  <header class="lower">
    <h1>{title}</h1>
    <p class="meta">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      {updatedDate && <span> · updated {formatDate(updatedDate)}</span>}
    </p>
  </header>

  <article class="prose">
    <slot />
  </article>
</Simple>

<style>
  header {
    margin-bottom: 2.5rem;
  }
  h1 {
    font-size: 1.6rem;
    font-weight: 500;
    line-height: 1.3;
    margin: 0 0 0.5rem;
  }
  .meta {
    color: #555;
    font-size: 0.85rem;
    margin: 0;
  }
</style>

<style is:global>
  .prose {
    color: #ccc;
    font-size: 1.05rem;
    line-height: 1.75;
  }
  .prose > :first-child {
    margin-top: 0;
  }
  .prose p,
  .prose ul,
  .prose ol,
  .prose blockquote,
  .prose pre,
  .prose table {
    margin: 0 0 1.25rem;
  }
  .prose h2,
  .prose h3,
  .prose h4 {
    color: #fff;
    font-weight: 500;
    line-height: 1.35;
    margin: 2.5rem 0 0.75rem;
  }
  .prose h2 {
    font-size: 1.2rem;
  }
  .prose h3 {
    font-size: 1.05rem;
  }
  .prose h4 {
    font-size: 1rem;
    color: #ccc;
  }
  .prose strong,
  .prose b {
    color: #fff;
    font-weight: 600;
  }
  .prose a {
    color: #fff;
    text-decoration: underline;
    text-decoration-color: #555;
    text-underline-offset: 3px;
  }
  .prose a:hover {
    text-decoration-color: #fff;
  }
  .prose ul,
  .prose ol {
    padding-left: 1.25rem;
  }
  .prose li {
    margin-bottom: 0.4rem;
  }
  .prose li::marker {
    color: #555;
  }
  .prose blockquote {
    border-left: 2px solid #333;
    padding-left: 1rem;
    margin-left: 0;
    color: #999;
    font-style: italic;
  }
  .prose code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.88em;
    background: #111;
    padding: 0.15em 0.35em;
    border-radius: 4px;
  }
  .prose pre {
    background: #0d0d0d;
    border: 1px solid #1f1f1f;
    border-radius: 6px;
    padding: 1rem;
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.6;
  }
  .prose pre code {
    background: none;
    padding: 0;
  }
  .prose img {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
    margin: 0.5rem 0;
  }
  .prose hr {
    border: 0;
    border-top: 1px solid #222;
    margin: 2.5rem 0;
  }
  .prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
    display: block;
    overflow-x: auto;
  }
  .prose th,
  .prose td {
    text-align: left;
    padding: 0.5rem 0.75rem 0.5rem 0;
    border-bottom: 1px solid #1f1f1f;
  }
  .prose th {
    color: #fff;
    font-weight: 500;
  }
</style>
